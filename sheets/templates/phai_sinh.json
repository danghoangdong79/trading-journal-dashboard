{
  "sheet_name": "JOURNAL_LOG",
  "description": "Schema cho giao dịch Phái sinh VN30F",
  "columns": [
    {"col": "A", "key": "stt", "label": "STT", "type": "auto", "formula": "=ROW()-{header_row}"},
    {"col": "B", "key": "trang_thai", "label": "Trạng Thái", "type": "enum", "options": ["✅ Win", "❌ Lose", "➖ Hòa", "⏳ Đang mở"], "input": true},
    {"col": "C", "key": "loai_tai_san", "label": "Loại TS", "type": "enum", "options": ["Phái sinh", "Cổ phiếu"], "input": true},
    {"col": "D", "key": "ma_gd", "label": "Mã GD", "type": "text", "input": true, "example": "VN30F2506"},
    {"col": "E", "key": "chien_luoc", "label": "Chiến Lược", "type": "enum", "input": true},
    {"col": "F", "key": "vi_the", "label": "Vị Thế", "type": "enum", "options": ["Long", "Short"], "input": true},
    {"col": "G", "key": "phien", "label": "Phiên", "type": "enum", "options": ["Sáng", "Chiều", "ATO", "ATC"], "input": true},
    {"col": "H", "key": "ngay_gio_vao", "label": "Ngày & Giờ Vào", "type": "datetime", "format": "dd/MM/yyyy HH:mm", "input": true},
    {"col": "I", "key": "thu", "label": "Thứ", "type": "auto", "formula": "=TEXT({H},\"dddd\")"},
    {"col": "J", "key": "ngay_gio_dong", "label": "Ngày & Giờ Đóng", "type": "datetime", "format": "dd/MM/yyyy HH:mm", "input": true},
    {"col": "K", "key": "thoi_gian_gd", "label": "TG Giao Dịch", "type": "auto", "formula": "=IF({J}<>\"\",TEXT({J}-{H},\"[h]\"&\"h \"&\"mm\"&\"m\"),\"\")"},
    {"col": "L", "key": "so_du", "label": "Số Dư", "type": "auto", "formula": "=IF({row}={first_data_row},CONFIG!$B$1,{prev_AD})"},
    {"col": "M", "key": "khoi_luong", "label": "Số HĐ", "type": "number", "input": true, "example": 2},
    {"col": "N", "key": "gia_vao", "label": "Giá Vào", "type": "number", "input": true, "example": 1285},
    {"col": "O", "key": "cat_lo", "label": "Cắt Lỗ (SL)", "type": "number", "input": true, "example": 1275},
    {"col": "P", "key": "sl_diem", "label": "SL (Điểm)", "type": "auto", "formula": "=IF({F}=\"Long\",{N}-{O},{O}-{N})"},
    {"col": "Q", "key": "chot_loi", "label": "Chốt Lời (TP)", "type": "number", "input": true, "example": 1300},
    {"col": "R", "key": "tp_diem", "label": "TP (Điểm)", "type": "auto", "formula": "=IF({F}=\"Long\",{Q}-{N},{N}-{Q})"},
    {"col": "S", "key": "gia_dong", "label": "Giá Đóng", "type": "number", "input": true, "example": 1300},
    {"col": "T", "key": "diem_thuc_te", "label": "Điểm Thực Tế", "type": "auto", "formula": "=IF({S}<>\"\",IF({F}=\"Long\",{S}-{N},{N}-{S}),\"\")"},
    {"col": "U", "key": "rr_ky_vong", "label": "R:R Kỳ Vọng", "type": "auto", "formula": "=IFERROR({R}/{P},\"\")"},
    {"col": "V", "key": "rui_ro_pct", "label": "Rủi Ro %", "type": "auto", "formula": "=IFERROR(({P}*{M}*CONFIG!$B$5)/{L},\"\")"},
    {"col": "W", "key": "muc_tieu_lai_pct", "label": "Mục Tiêu Lãi %", "type": "auto", "formula": "=IFERROR(({R}*{M}*CONFIG!$B$5)/{L},\"\")"},
    {"col": "X", "key": "lai_lo_gop", "label": "Lãi/Lỗ Gộp", "type": "auto", "formula": "=IF({S}<>\"\",{T}*{M}*CONFIG!$B$5,\"\")"},
    {"col": "Y", "key": "pct_thay_doi_gop", "label": "% Thay Đổi Gộp", "type": "auto", "formula": "=IFERROR({X}/{L},\"\")"},
    {"col": "Z", "key": "phi_gd", "label": "Phí GD", "type": "auto", "formula": "={M}*CONFIG!$B$4*2", "note": "Phí 2 chiều (vào + ra)"},
    {"col": "AA", "key": "thue", "label": "Thuế", "type": "auto", "formula": "=0", "note": "Phái sinh không có thuế"},
    {"col": "AB", "key": "lai_lo_rong", "label": "Lãi/Lỗ Ròng", "type": "auto", "formula": "=IF({X}<>\"\",{X}-{Z}-{AA},\"\")"},
    {"col": "AC", "key": "lai_lo_tich_luy", "label": "L/L Tích Lũy", "type": "auto", "formula": "=IF({row}={first_data_row},{AB},IF({AB}<>\"\",{prev_AC}+{AB},\"\"))"},
    {"col": "AD", "key": "so_du_da_dong", "label": "Số Dư Đã Đóng", "type": "auto", "formula": "=IF({AB}<>\"\",{L}+{AB},\"\")"},
    {"col": "AE", "key": "pct_thay_doi_rong", "label": "% TĐ Ròng", "type": "auto", "formula": "=IFERROR({AB}/{L},\"\")"},
    {"col": "AF", "key": "pct_tang_truong", "label": "% Tăng Trưởng", "type": "auto", "formula": "=IFERROR({AD}/CONFIG!$B$1-1,\"\")"},
    {"col": "AG", "key": "tam_ly", "label": "Tâm Lý", "type": "enum", "input": true},
    {"col": "AH", "key": "ghi_chu", "label": "Ghi Chú", "type": "text", "input": true}
  ],
  "formulas_reference": {
    "CONFIG!$B$1": "Vốn ban đầu",
    "CONFIG!$B$4": "Phí phái sinh / HĐ / chiều",
    "CONFIG!$B$5": "Giá trị 1 điểm (100.000 VNĐ)"
  }
}
