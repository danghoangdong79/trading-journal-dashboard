    {
      "col": "R",
      "key": "bien_do",
      "label": "Bi\u00ean \u0110\u1ed9",
      "type": "auto",
      "formula": "={\"Bi\u00ean \u0110\u1ed9\"; ARRAYFORMULA(IF(D2:D=\"\", \"\", IF(O2:O=\"\", \"\", IF(REGEXMATCH(UPPER(E2:E), \"MUA|LONG\"), O2:O-N2:N, N2:N-O2:O))))}"
    },
    {
      "col": "S",
      "key": "lai_lo_gop",
      "label": "L\u00e3i/L\u1ed7 G\u1ed9p",
      "type": "auto",
      "formula": "={\"L\u00e3i/L\u1ed7 G\u1ed9p\"; ARRAYFORMULA(IF(D2:D=\"\", \"\", IF(O2:O=\"\", \"\", R2:R * M2:M * IF(C2:C=\"Ph\u00e1i sinh\", CONFIG!$C$6, CONFIG!$C$3))))}"
    },
    {
      "col": "T",
      "key": "phi_thue",
      "label": "Ph\u00ed & Thu\u1ebf",
      "type": "auto",
      "formula": "={\"Ph\u00ed & Thu\u1ebf\"; ARRAYFORMULA(IF(D2:D=\"\", \"\", IF(O2:O=\"\", \"\", IF(C2:C=\"Ph\u00e1i sinh\", M2:M * (CONFIG!$C$7 + CONFIG!$C$8) * 2, (N2:N * M2:M * CONFIG!$C$3 * CONFIG!$C$4) + (O2:O * M2:M * CONFIG!$C$3 * (CONFIG!$C$4 + CONFIG!$C$5))))))}"
    },
    {
      "col": "U",
      "key": "lai_lo_rong",
      "label": "L\u00e3i/L\u1ed7 R\u00f2ng",
      "type": "auto",
      "formula": "={\"L\u00e3i/L\u1ed7 R\u00f2ng\"; ARRAYFORMULA(IF(D2:D=\"\", \"\", IF(O2:O=\"\", \"\", S2:S - T2:T)))}"
    },
    {
      "col": "V",
      "key": "tam_ly",
      "label": "T\u00e2m L\u00fd",
      "type": "enum",
      "source": "FORMULAS!$D$2:$D",
      "input": true
    },
    {
      "col": "W",
      "key": "ghi_chu_review",
      "label": "Ghi Ch\u00fa Review",
      "type": "text",
      "input": true
    },
    {
      "col": "X",
      "key": "nhom_nganh",
      "label": "Nh\u00f3m Ng\u00e0nh",
      "type": "auto",
      "formula": "=ARRAYFORMULA(IF(D2:D=\"\", \"\", IFERROR(VLOOKUP(D2:D, SETUP!E:G, 3, 0), IFERROR(VLOOKUP(D2:D, SETUP!O:Q, 3, 0), \"Kh\u00e1c\"))))"
    }
  ],
